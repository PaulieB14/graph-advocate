# Optional. Override to point at a self-hosted Graph Advocate.
GRAPH_ADVOCATE_URL=https://graphadvocate.com

# Optional. Your EVM wallet, sent as the identified sender. The free daily tier
# is only granted to a well-formed address (0x + 40 hex); a bare agent name does
# not qualify, and anonymous callers pay from call 1.
GRAPH_ADVOCATE_SENDER=

# Optional. Per-request timeout in milliseconds (default 60000). A cold
# /agent/score scan can take 15-25s, so do not set this too low.
GRAPH_ADVOCATE_TIMEOUT_MS=60000
